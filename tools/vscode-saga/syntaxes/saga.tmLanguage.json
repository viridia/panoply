{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SAGA",
  "scopeName": "source.saga",
  "patterns": [
    { "include": "#comments" },
    { "include": "#import" },
    { "include": "#function" },
    { "include": "#struct" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.saga", "match": "//.*$" }
      ]
    },
    "import": {
      "begin": "\\b(import)\\b",
      "beginCaptures": { "1": { "name": "keyword.control.import.saga" } },
      "end": ";",
      "patterns": [
        { "name": "keyword.other.saga", "match": "\\b(package|super)\\b" },
        { "name": "punctuation.separator.namespace.saga", "match": "::" },
        { "name": "entity.name.namespace.saga", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "function": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.fn.saga" },
        "2": { "name": "entity.name.function.saga" }
      }
    },
    "struct": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.struct.saga" },
        "2": { "name": "entity.name.type.saga" }
      }
    },
    "strings": {
      "name": "string.quoted.double.saga",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.saga", "match": "\\\\(?:[nrt\"'\\\\0]|u\\{[0-9A-Fa-f]{1,6}\\})" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.saga",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9_]*(?:e[+-]?[0-9][0-9_]*)?|e[+-]?[0-9][0-9_]*)(f32|f64)?|\\b[0-9][0-9_]*(f32|f64)\\b"
        },
        {
          "name": "constant.numeric.integer.saga",
          "match": "\\b[0-9][0-9_]*(i32|i64)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.saga", "match": "\\b(if|else)\\b" },
        { "name": "keyword.other.saga", "match": "\\b(let|const|pub|as)\\b" },
        { "name": "constant.language.boolean.saga", "match": "\\b(true|false)\\b" },
        { "name": "variable.language.self.saga", "match": "\\bself\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.saga", "match": "\\b(bool|i32|i64|f32|f64)\\b" },
        { "name": "entity.name.type.saga", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.saga" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.namespace.saga", "match": "::" },
        { "name": "keyword.operator.arrow.saga", "match": "->" },
        { "name": "keyword.operator.logical.saga", "match": "&&|\\|\\||!(?!=)" },
        { "name": "keyword.operator.comparison.saga", "match": "==|!=|<=|>=|<(?!<)|>(?!>)" },
        { "name": "keyword.operator.assignment.saga", "match": "(?:[-+*/%&|^]|<<|>>)?=" },
        { "name": "keyword.operator.arithmetic.saga", "match": "<<|>>|[-+*/%&|^~]" }
      ]
    }
  }
}
